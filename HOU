// ---- small pieces --------------------------------------------------------
function Chev({ open }) {
  return (
    <svg className={"chev" + (open ? " open" : "")} width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
  );
}
function telHref(v) { return "tel:+1" + v.replace(/[^0-9]/g, ""); }
function Meta({ meta }) {
  if (!meta || meta.length === 0) return null;
  return (
    <div className="meta">
      {meta.map((m, i) => m.u
        ? <a key={i} className="link" href={m.u} target="_blank" rel="noreferrer">{m.l} ↗</a>
        : <a key={i} className="tel" href={telHref(m.t)}>{m.t}</a>)}
    </div>
  );
}

// ---- app -----------------------------------------------------------------
export default function App() {
  const [openAcc, setOpenAcc] = useState({ power: true });
  const [board, setBoard] = useState({});
  const [loaded, setLoaded] = useState(false);
  const saveTimer = useRef(null);

  useEffect(() => {
    let alive = true;
    (async () => {
      try {
        const r = await window.storage.get("callboard-v4", true);
        if (alive && r && r.value) setBoard(JSON.parse(r.value));
      } catch (e) { /* first run or storage off */ }
      if (alive) setLoaded(true);
    })();
    return () => { alive = false; };
  }, []);

  const persist = (next) => {
    setBoard(next);
    if (saveTimer.current) clearTimeout(saveTimer.current);
    saveTimer.current = setTimeout(async () => {
      try { await window.storage.set("callboard-v4", JSON.stringify(next), true); } catch (e) { /* keep local */ }
    }, 550);
  };
  const setWho = (id, v) => persist({ ...board, [id]: { ...board[id], who: v } });
  const toggleDone = (id) => persist({ ...board, [id]: { ...board[id], done: !board[id]?.done } });
  const resetBoard = () => persist({});
  const toggleAcc = (id) => setOpenAcc((s) => ({ ...s, [id]: !s[id] }));
  const doneCount = Object.values(board).filter((x) => x?.done).length;

  return (
    <div className="wrap">
      <style>{FONTS + CSS}</style>
      <div className="shell">

        {/* hero */}
        <header className="hero rise">
          <div className="eyebrow">Kendra's RV plan · shared</div>
          <h1 className="serif">Getting her to Houston.</h1>
          <div className="route">
            <span><b>Denver, CO</b></span>
            <span className="arrow">———›</span>
            <span><b>MD Anderson</b>, Houston</span>
            <span style={{ color: "var(--marigold)" }}>·</span>
            <span>Aug 19, 2026</span>
          </div>
          <p className="lede">We're taking an RV: our own quiet room on wheels, a bed she can lie on her side in, power and cooling for her gear, and space for all four of us. Below is where to rent it near Denver, how to keep her oxygen and TPN powered, and where to park minutes from her appointment.</p>
          <div className="howto"><b>How to use this:</b> the calls in section 1 are the plan. Put your name on the ones you'll take and mark them done, so nobody double-dials and everyone sees where things stand. It syncs for anyone with the link.</div>
        </header>

        {/* call board */}
        <section className="sec">
          <div className="sec-head"><span className="sec-num">01</span><h2 className="serif">Day 1 calls</h2></div>
          <p className="sec-sub">In order. Claim the ones you'll take. Tap a number to dial from your phone.</p>
          <div className="board">
            {CALLS.map((c) => {
              const st = board[c.id] || {};
              return (
                <div key={c.id} className={"callcard" + (st.done ? " done" : "")}>
                  <div className="cc-top">
                    <span className="cc-rank">{c.rank}</span>
                    <div className="cc-body">
                      <div className="cc-name serif">{c.name}</div>
                      <div className="cc-why">{c.why}</div>
                      {(c.nums.length > 0 || c.web) && (
                        <div className="cc-nums">
                          {c.nums.map((n) => (
                            <span key={n.v} style={{ fontSize: 13 }}>
                              <span className="eyebrow" style={{ marginRight: 6 }}>{n.label}</span>
                              <a className="tel" href={telHref(n.v)}>{n.v}</a>
                            </span>
                          ))}
                          {c.web && (<a className="link" href={c.web} target="_blank" rel="noreferrer">website ↗</a>)}
                        </div>
                      )}
                    </div>
                  </div>
                  <div className="cc-ctrl">
                    <input className="who" placeholder="Who's on it?" value={st.who || ""} onChange={(e) => setWho(c.id, e.target.value)} disabled={!loaded} />
                    <button className={"donebtn" + (st.done ? " on" : "")} onClick={() => toggleDone(c.id)}>
                      <span className="box">{st.done ? "✓" : ""}</span>{st.done ? "Done" : "Mark done"}
                    </button>
                  </div>
                </div>
              );
            })}
          </div>
          <div className="boardnote">
            <span>{loaded ? `${doneCount} of ${CALLS.length} done` : "syncing…"}</span>
            <span>·</span><span>Shared with everyone who has the link.</span>
            {doneCount > 0 && (<><span>·</span><button className="reset" onClick={resetBoard}>Reset board</button></>)}
          </div>
        </section>

        {/* RV game plan */}
        <section className="sec">
          <div className="sec-head"><span className="sec-num">02</span><h2 className="serif">The RV plan</h2></div>
          <p className="sec-sub">Rent it near Denver, keep her gear powered, drive down in gentle legs, and park minutes from MD Anderson. Leave the 15th, appointment the 19th, home around the 24th.</p>
          <div className="plan">

            {/* power warning first, it's the whole ballgame */}
            <div className="warn">
              <div className="wt serif">Read this first: powering her oxygen &amp; TPN</div>
              <div className="wl">the one thing that makes or breaks the trip</div>
              <ul>
                {POWER.map((p, i) => <li key={i} dangerouslySetInnerHTML={{ __html: p.replace(/DEAD/g, "<b>DEAD</b>").replace(/60°F/g, "<b>60°F</b>") }} />)}
              </ul>
            </div>

            {/* rent */}
            <div className="pblock">
              <div className="ph serif">Rent it, near Denver</div>
              <div className="psub">Ranked for this trip. The generator matters more than the sticker price, because she needs hours of power a day.</div>
              {RENTALS.map((r) => (
                <div key={r.nm} className="pcard">
                  <div className="pcard-h">
                    <span className="pn">{r.nm}</span>
                    <span className={"tag2" + (r.tag.includes("best value") ? "" : r.tag.includes("fallback") || r.tag.includes("pricier") ? " gray" : " alt")}>{r.tag}</span>
                    <span className="pricetag">{r.price}</span>
                    <span className={"gen " + r.gen.k}>{r.gen.t}</span>
                  </div>
                  <div className="pcard-loc">{r.loc}</div>
                  <Meta meta={r.meta} />
                  <div className="pcard-note">{r.note}</div>
                </div>
              ))}
              <div className="callout">{RENTALS_NOTE}</div>
            </div>

            {/* drive */}
            <div className="pblock">
              <div className="ph serif">The drive down</div>
              <div className="psub">About 1,030 miles each way, split into easy days with power at every stop.</div>
              <div className="tl">
                {ITINERARY.map((d, i) => (
                  <div key={i} className={"tl-item" + (d.hi ? " hi" : "")}>
                    <div className="tl-date">{d.date}</div>
                    <div className="tl-body">
                      <div className="tll">{d.tll}</div>
                      {d.tlm && <div className="tlm">{d.tlm}</div>}
                      <div className="tls">{d.tls}</div>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            {/* base */}
            <div className="pblock">
              <div className="ph serif">Base near MD Anderson</div>
              <div className="psub">Full-hookup parks by the Texas Medical Center, most with a free shuttle to the door.</div>
              {HOU_PARKS.map((p) => (
                <div key={p.nm} className="pcard">
                  <div className="pcard-h">
                    <span className="pn">{p.nm}</span>
                    <span className={"tag2" + (p.tag === "top pick" ? "" : p.tag === "backup" ? " gray" : " alt")}>{p.tag}</span>
                    <span className="pricetag">{p.price}</span>
                  </div>
                  <Meta meta={p.meta} />
                  <div className="pcard-note">{p.note}</div>
                </div>
              ))}
            </div>

            {/* errand car */}
            <div className="pblock">
              <div className="ph serif">A cheap errand car in Houston</div>
              <div className="psub">So you're not moving the whole rig for a grocery run.</div>
              <div className="pcard">
                <div className="pcard-h">
                  <span className="pn">{HOU_CAR.nm}</span>
                  <span className="tag2">patient discount</span>
                  <span className="pricetag">{HOU_CAR.price}</span>
                </div>
                <div className="pcard-loc">{HOU_CAR.loc}</div>
                <Meta meta={HOU_CAR.meta} />
                <div className="pcard-note">{HOU_CAR.note}</div>
                <div className="pcard-note" style={{ marginTop: 8 }}>{HOU_CAR.alt}</div>
              </div>
            </div>

            {/* cost */}
            <div className="pblock">
              <div className="ph serif">What it runs</div>
              <div className="psub">A ballpark for the full round trip. Get the all-in rental quote in writing.</div>
              {RV_COSTS.map((c, i) => (
                <div key={i} className={"cb-row" + (c.total ? " total" : "")}>
                  <span>{c.label}</span><span className="cbv">{c.v}</span>
                </div>
              ))}
              <div className="callout">This also covers her lodging the whole stay, so it offsets hotels for the crew. Ask MD Anderson Social Work (713-792-6195) about fuel and travel grants to bring it down further.</div>
            </div>

          </div>
        </section>

        {/* logistics */}
        <section className="sec">
          <div className="sec-head"><span className="sec-num">03</span><h2 className="serif">Her gear, sorted</h2></div>
          <p className="sec-sub">Power, TPN, a lodging backup, and help with the bills.</p>
          <div>
            {LOGISTICS.map((l) => {
              const open = !!openAcc[l.id];
              return (
                <div key={l.id} className="acc">
                  <button className="acc-btn" onClick={() => toggleAcc(l.id)} aria-expanded={open}>
                    <span className="at serif">{l.t}</span><Chev open={open} />
                  </button>
                  <div className={"exp" + (open ? " open" : "")}>
                    <div><div className="acc-inner">{l.body}</div></div>
                  </div>
                </div>
              );
            })}
          </div>
        </section>

        {/* caveats */}
        <section className="sec">
          <div className="sec-head"><span className="sec-num">04</span><h2 className="serif">Read before you book</h2></div>
          <p className="sec-sub">The honest fine print, so no one burns a day or a deposit.</p>
          <div className="cav">
            <ul style={{ margin: 0, paddingLeft: 18 }}>
              {CAVEATS.map(([h, b], i) => (<li key={i}><b>{h}</b>{b}</li>))}
            </ul>
          </div>
        </section>

        <footer className="foot">
          Put together to make the booking easier to split up. Prices and availability shift with the season, so confirm on each call. The move that unlocks the rest: lock the RV (with its power sorted) and the Houston park, then work down the list.
        </footer>
      </div>
    </div>
  );
}
